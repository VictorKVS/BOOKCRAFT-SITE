    "STRUCTURE",
    "LITERARY_CANON",
    "CHARACTER_BIBLE",
    "WORLD_BIBLE",
    "KNOWLEDGE_STATE",
    "BOOK_GLOSSARY",
    "CULTURAL_EMBODIMENTS",
    "CULTURAL_CANON_LOCKS",
    "VISUAL_BIBLE",
    "CONTRADICTION_CHECK",
    "CANON_ACCEPTANCE",
    "STORY_HYPOTHESIS",
    "CANON_VERIFY",
    "STORY_GENERATION",
    "COMIC_ADAPTATION",
    "PAGE_PLAN",
    "PANEL_PLAN",
    "VISUAL_GENERATION",
    "VISUAL_CRITIC"
