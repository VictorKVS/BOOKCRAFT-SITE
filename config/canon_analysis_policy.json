    "source_first": true,
    "external_knowledge_requires_separate_provenance": true,
    "must_keep_evidence": true,
    "allow_unresolved_terms": true
  },
  "cultural_embodiments_policy": {
    "separate_from_literary_canon": true,
    "user_selects_locked_reference": true,
    "may_inform_visual_identity": true,
    "may_not_rewrite_source_facts": true
  }
}
