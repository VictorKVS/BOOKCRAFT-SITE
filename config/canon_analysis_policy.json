  "provenance_types": [
    "SOURCE_CANON",
    "USER_LOCKED_CANON",
    "USER_LOCKED_CULTURAL_CANON",
    "DERIVED",
    "HYPOTHESIS"
  ],
  "creative_generation_requires": [
    "character_bible",
    "world_bible",
    "visual_bible",
    "forbidden_contradictions",
    "canon_acceptance",
    "book_glossary",
    "cultural_embodiments_registry"
  ],
  "cultural_canon_policy": {
    "may_override_visual_adaptation": true,
    "may_rewrite_literal_source_facts": false,
    "must_keep_provenance": true
